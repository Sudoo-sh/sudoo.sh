# Sudoo settings. Copied to /opt/odoo/manager/.env by install.sh, which keeps values already set.
# After a change: cd /opt/odoo/manager && docker compose up -d
# All settings, their types and defaults: docs/CONFIGURATION.md. Check what the panel uses: sudoo config
# Settings marked "live" there (behaviour, contact, versions) can also be changed on the panel's Settings page; those
# changes take effect at once and are kept on top of this file (Reset brings back the value here).

# ----------------------------------------------------------------------------- contact
# Who users are told to contact when something needs the administrator
ADMIN_CONTACT_NAME=the administrator
ADMIN_CONTACT_PHONE=
ADMIN_CONTACT_EMAIL=

# ----------------------------------------------------------------------------- Odoo versions
# "auto": every published x.0 version of ODOO_IMAGE on Docker Hub, from ODOO_MIN_VERSION on.
# Or a fixed list, for example: ODOO_VERSIONS=17.0,18.0,19.0
ODOO_VERSIONS=auto
ODOO_MIN_VERSION=16.0
# Docker images (the tag of ODOO_IMAGE is the Odoo version)
ODOO_IMAGE=odoo
POSTGRES_IMAGE=postgres:16
# Password of the Odoo user "admin" in new instances
ODOO_ADMIN_PASSWORD=admin

# ----------------------------------------------------------------------------- Enterprise add-ons (plugin)
# Where the Odoo Enterprise add-ons come from: folder, git, or none (Community only). See docs/PLUGINS.md.
ENTERPRISE_SOURCE=folder
# folder: where the add-ons of a version are. {version} becomes 19.0, {major} becomes 19.
ENTERPRISE_PATH=/opt/odoo/enterprise/{version}
# git: a repository with one branch per version (give the server a deploy key for it under GitHub access).
ENTERPRISE_GIT_URL=
ENTERPRISE_GIT_BRANCH={version}
# A module that must be present for the add-ons of a version to count as available
ENTERPRISE_MARKER=web_enterprise

# ----------------------------------------------------------------------------- exposure (plugin)
# How the panel and the instances are reached from outside:
#   cloudflare-quick  free https link per instance through Cloudflare; no open port, no domain (links change
#                     when the server restarts)
#   host-ports        visitors connect to <PUBLIC_SCHEME>://<PUBLIC_HOST>:<port>; the ports must be open
EXPOSURE=cloudflare-quick
# host-ports only
PUBLIC_HOST=
PUBLIC_SCHEME=http

# ----------------------------------------------------------------------------- code updates (plugins)
# What starts a code update, comma-separated (several can work together):
#   polling          check GitHub every POLL_MINUTES; works everywhere
#   github-webhook   GitHub calls <panel address>/hooks/github on every push; needs a panel address that does not
#                    change (host-ports or your own domain) and the secret below, also entered on GitHub
UPDATE_TRIGGERS=polling
GITHUB_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------- ports
PANEL_PORT=9000
# Live event stream (/api/v1/events), 127.0.0.1 only
EVENTS_PORT=9001
GATEWAY_PORT_START=8069
ODOO_PORT_START=28069

# ----------------------------------------------------------------------------- behaviour
# Pause an instance after this many hours without visits (0: never)
IDLE_HOURS=6
# Defaults of the automation switches of new instances (each instance can change its own)
AUTO_PAUSE=true
AUTO_UPDATE=true
AUTO_UPGRADE=true
# Lifetime offered for new instances: deleted (after a backup) this many days after creation.
# Each instance can be set to "keep" instead, when it is created or later. 0 offers "keep" by default.
DELETE_AFTER_DAYS=30
# polling: check GitHub for new commits every this many minutes
POLL_MINUTES=2
# Panel sessions: end after this many idle minutes, and at the latest after this many hours
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
