# Sudoo settings. Written to /opt/odoo/manager/.env by the installer, which keeps every value already set there.
# After a change: cd /opt/odoo/manager && docker compose up -d
# All settings, their types and defaults: docs/CONFIGURATION.md. Check what the panel uses: sudoo config
# Settings marked "live" there (behaviour, contact, versions) can also be changed on the panel's Settings page; those
# changes take effect at once and are kept on top of this file (Reset brings back the value here).

# ----------------------------------------------------------------------------- contact
# Who users are told to contact when something needs the administrator
ADMIN_CONTACT_NAME=the administrator
ADMIN_CONTACT_PHONE=
ADMIN_CONTACT_EMAIL=

# ----------------------------------------------------------------------------- Odoo versions
# "auto": every published x.0 version of ODOO_IMAGE on Docker Hub, from ODOO_MIN_VERSION on.
# Or a fixed list, for example: ODOO_VERSIONS=17.0,18.0,19.0
ODOO_VERSIONS=auto
ODOO_MIN_VERSION=16.0
# Download the Odoo image of every offered version (and the PostgreSQL image) in the background, so the first
# instance of a version does not wait for the download; each Odoo image takes 1-3 GB of disk
PREPULL_IMAGES=false
# Docker images (the tag of ODOO_IMAGE is the Odoo version)
ODOO_IMAGE=odoo
POSTGRES_IMAGE=postgres:16
# Password of the Odoo user "admin" in new instances
ODOO_ADMIN_PASSWORD=admin

# ----------------------------------------------------------------------------- instance containers
# Resources (applied when an instance next starts, or with "Apply resources" on its Settings tab). Instances have
# no processor or memory limit by default: limits below are defaults per stage, 0 meaning "not set" (no container
# limit, Odoo's own default in odoo.conf). An admin can also set them for one instance in the panel.
#
# Priority when the server is busy: production first, then staging, then development. These weights only act under
# contention. Processor weight (Docker cpu_shares, 1024 is Docker's default):
PRIORITY_CPU_WEIGHT_PRODUCTION=4096
PRIORITY_CPU_WEIGHT_STAGING=2048
PRIORITY_CPU_WEIGHT_DEVELOPMENT=1024
# Out-of-memory score (-999 to 1000): when memory runs out the kernel stops the highest score first
PRIORITY_OOM_SCORE_PRODUCTION=0
PRIORITY_OOM_SCORE_STAGING=300
PRIORITY_OOM_SCORE_DEVELOPMENT=600
# Memory reservation (soft limit) of the Odoo and database containers: under pressure, memory is taken back from
# the containers above their reservation first; 0: none
PRIORITY_MEMORY_RESERVATION_PRODUCTION=1g
PRIORITY_DB_MEMORY_RESERVATION_PRODUCTION=512m
PRIORITY_MEMORY_RESERVATION_STAGING=0
PRIORITY_DB_MEMORY_RESERVATION_STAGING=0
PRIORITY_MEMORY_RESERVATION_DEVELOPMENT=0
PRIORITY_DB_MEMORY_RESERVATION_DEVELOPMENT=0
#
# Default limits of each stage: Odoo workers (0: threaded mode) and cron workers, memory per worker in MB
# (limit_memory_soft/hard), seconds per request (limit_time_cpu/real), then container limits: memory in Docker units
# (512m, 2g) and processor cores.
PRODUCTION_ODOO_WORKERS=0
PRODUCTION_ODOO_CRON_THREADS=0
PRODUCTION_ODOO_LIMIT_MEMORY_SOFT_MB=0
PRODUCTION_ODOO_LIMIT_MEMORY_HARD_MB=0
PRODUCTION_ODOO_LIMIT_TIME_CPU=0
PRODUCTION_ODOO_LIMIT_TIME_REAL=0
PRODUCTION_ODOO_MEMORY_LIMIT=0
PRODUCTION_ODOO_CPU_LIMIT=0
PRODUCTION_DB_MEMORY_LIMIT=0
PRODUCTION_DB_CPU_LIMIT=0
STAGING_ODOO_WORKERS=0
STAGING_ODOO_CRON_THREADS=0
STAGING_ODOO_LIMIT_MEMORY_SOFT_MB=0
STAGING_ODOO_LIMIT_MEMORY_HARD_MB=0
STAGING_ODOO_LIMIT_TIME_CPU=0
STAGING_ODOO_LIMIT_TIME_REAL=0
STAGING_ODOO_MEMORY_LIMIT=0
STAGING_ODOO_CPU_LIMIT=0
STAGING_DB_MEMORY_LIMIT=0
STAGING_DB_CPU_LIMIT=0
DEVELOPMENT_ODOO_WORKERS=0
DEVELOPMENT_ODOO_CRON_THREADS=0
DEVELOPMENT_ODOO_LIMIT_MEMORY_SOFT_MB=0
DEVELOPMENT_ODOO_LIMIT_MEMORY_HARD_MB=0
DEVELOPMENT_ODOO_LIMIT_TIME_CPU=0
DEVELOPMENT_ODOO_LIMIT_TIME_REAL=0
DEVELOPMENT_ODOO_MEMORY_LIMIT=0
DEVELOPMENT_ODOO_CPU_LIMIT=0
DEVELOPMENT_DB_MEMORY_LIMIT=0
DEVELOPMENT_DB_CPU_LIMIT=0
# Processes and threads one container may run at the same time
CONTAINER_PIDS_LIMIT=1024
# Container log rotation: size of one file, and how many files are kept
CONTAINER_LOG_MAX_SIZE=10m
CONTAINER_LOG_MAX_FILES=3
# When an instance's containers or files are changed outside the panel: warn (report it: audit log, banner, e-mail
# to super admins) or restore (report it, then recreate Odoo and its database from the panel's configuration,
# backing the database up first). Connectors are only ever reported. See docs/SECURITY.md.
DRIFT_ACTION=restore

# ----------------------------------------------------------------------------- Enterprise add-ons (plugin)
# Where the Odoo Enterprise add-ons come from: folder, git, or none (Community only). See docs/PLUGINS.md.
ENTERPRISE_SOURCE=folder
# folder: where the add-ons of a version are. {version} becomes 19.0, {major} becomes 19.
ENTERPRISE_PATH=/opt/odoo/enterprise/{version}
# git: a repository with one branch per version (give the server a deploy key for it under GitHub access).
ENTERPRISE_GIT_URL=
ENTERPRISE_GIT_BRANCH={version}
# A module that must be present for the add-ons of a version to count as available
ENTERPRISE_MARKER=web_enterprise

# ----------------------------------------------------------------------------- exposure (plugin)
# How the panel and the instances are reached from outside:
#   cloudflare-quick  free https link per instance through Cloudflare; no open port, no domain (links change
#                     when the server restarts)
#   host-ports        visitors connect to <PUBLIC_SCHEME>://<PUBLIC_HOST>:<port>; the ports must be open
EXPOSURE=cloudflare-quick
# host-ports only
PUBLIC_HOST=
PUBLIC_SCHEME=http

# ----------------------------------------------------------------------------- code updates (plugins)
# What starts a code update, comma-separated (several can work together):
#   polling          check GitHub every POLL_MINUTES; works everywhere
#   github-app       the panel's GitHub App (Connect GitHub on the GitHub access page) calls
#                    <panel address>/hooks/github-app on every push; nothing to set up per repository, and the
#                    panel keeps the app's webhook address current when its own address changes
#   github-webhook   one webhook per repository: GitHub calls <panel address>/hooks/github on every push; needs a
#                    panel address that does not change (host-ports or your own domain) and the secret below, also
#                    entered on GitHub
UPDATE_TRIGGERS=polling,github-app
GITHUB_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------- storage, sign-in, e-mail (plugins)
# The panel's own data: sqlite (/opt/odoo/manager/sudoo.db)
STORAGE=sqlite
# How passwords are checked: local (the panel's accounts)
AUTH=local
# Second factors offered at sign-in: email (needs SMTP below), totp (authenticator app)
SECOND_FACTORS=email,totp
# Who must use one: none, admins, everyone (also on the Settings page)
REQUIRE_SECOND_FACTOR=admins
# E-mail, for sign-in codes: your own mailbox, e.g. your website's no-reply address. Empty SMTP_HOST: no e-mail.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USERNAME=the address, SMTP_PASSWORD=an app password (docs/CONFIGURATION.md).
# Test: docker exec sudoo-panel sudoo.sh test-email you@example.com
MAILER=smtp
MAIL_FROM=Sudoo.sh <no-reply@your-site.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Folder with a layout.html replacing the frame of every e-mail (texts: E-mail templates page); accent colour
MAIL_TEMPLATES_DIR=
BRAND_COLOR=#714B67
# Language of the web app for accounts that have not chosen one (each person can choose on their account page): en or ar
DEFAULT_LANGUAGE=en
# Oldest version of the Sudoo.sh Licence Agreement that counts; a newer one makes super admins accept it again
LICENCE_REQUIRED_VERSION=1.0
# Days after the first run to link the panel to a Sudoo.sh account; after that, while unlinked, no new instances,
# no stage changes into production and no updates (instances keep serving, backups keep running).
LINK_DEADLINE_DAYS=7

# ----------------------------------------------------------------------------- limits (also on the Settings page)
RATE_LIMITER=memory
# Requests per minute per user, API token or address; 0: no limit
RATE_LIMIT_READS_PER_MINUTE=600
RATE_LIMIT_CHANGES_PER_MINUTE=60
# Instances: on the server, per user, and minutes between two creations of one user; 0: no limit
MAX_INSTANCES=0
MAX_INSTANCES_PER_USER=0
CREATE_COOLDOWN_MINUTES=0
# Capacity: how many instances this server runs comfortably (docs/ADMIN_GUIDE.md). Memory kept free for the system
# (the larger of MB and %), memory counted per running instance until one is measured (MB), server memory use (%)
# from which the dashboard warns, and running instances at most (creating or starting more is refused; 0: only warn)
CAPACITY_RESERVE_MB=1024
CAPACITY_RESERVE_PERCENT=10
CAPACITY_INSTANCE_MEMORY_MB=700
CAPACITY_WARNING_PERCENT=85
MAX_RUNNING_INSTANCES=0

# ----------------------------------------------------------------------------- gateway (also on the Settings page)
# Where the gateways run: "service" (their own container, sudoo-gateway: instances keep answering while the panel
# restarts) or "embedded" (inside the panel). service: seconds the gateway service may not answer before the panel
# serves the instances itself
# GATEWAY_MODE=service
# GATEWAY_TAKEOVER_SECONDS=10
# What the gateway in front of every instance accepts: largest request body (MB), seconds a visitor may stay silent
# while sending one, largest WebSocket message (MB)
GATEWAY_MAX_UPLOAD_MB=2048
GATEWAY_IDLE_TIMEOUT_SECONDS=120
GATEWAY_WEBSOCKET_MAX_MESSAGE_MB=16
# .env only: seconds a connection has to send a request's headers, and connections open at once to one instance's
# gateway and to all of them (more are answered 503); keep the total well below the container's open-files limit
# GATEWAY_HEADER_TIMEOUT_SECONDS=30
# GATEWAY_MAX_CONNECTIONS=1000
# GATEWAY_MAX_CONNECTIONS_TOTAL=4000

# ----------------------------------------------------------------------------- custom domains (also on the Settings page)
# Custom domains for instances (docs/ADMIN_GUIDE.md, Custom domains): "off", "acme" (the gateway answers on ports 80
# and 443 and gets certificates from an ACME authority) or "external" (your own Cloudflare tunnel or proxy handles
# https in front of the instance's gateway port)
CUSTOM_DOMAINS=off
# The ACME authority: "production" (Let's Encrypt), "staging" (Let's Encrypt's test authority) or a directory address;
# contact e-mail given to it (empty: ADMIN_CONTACT_EMAIL)
ACME_DIRECTORY=production
ACME_EMAIL=
# Renew this many days before expiry; longest wait between two attempts after a failure (hours)
CERTIFICATE_RENEW_DAYS=30
CERTIFICATE_RETRY_MAX_HOURS=24
# Domains per instance (0: none); the name or address domains point to (empty: PUBLIC_HOST); DNS lookup timeout;
# check over http before asking for a certificate
DOMAINS_PER_INSTANCE=5
DOMAIN_DNS_TARGET=
DOMAIN_DNS_TIMEOUT_SECONDS=5
DOMAIN_HTTP_PROBE=true
# .env only: the ports custom domains are answered on (the ACME authority always checks port 80)
# DOMAIN_HTTP_PORT=80
# DOMAIN_HTTPS_PORT=443
# Managed subdomains (every plan): <branch>.<stage>.<company>.<base> for each instance when the linked Sudoo.sh
# account offers them; served with the panel's own certificates (ports 80 and 443 must reach this server)
MANAGED_SUBDOMAINS=true
# The company part of the names, asked for with the account's first name; empty: Sudoo.sh makes it
MANAGED_SUBDOMAIN_COMPANY=
MANAGED_SUBDOMAINS_CHECK_MINUTES=15

# ----------------------------------------------------------------------------- ports
# The panel's address: the web app (sudoo-web) listens here; the backend on API_PORT, 127.0.0.1 only
PANEL_PORT=9000
API_PORT=9002
# Live event stream (/api/v1/events), 127.0.0.1 only
EVENTS_PORT=9001
GATEWAY_PORT_START=8069
ODOO_PORT_START=28069

# ----------------------------------------------------------------------------- behaviour
# Pause an instance after this many hours without visits (0: never)
IDLE_HOURS=6
# Defaults of the automation switches of new instances (each instance can change its own)
AUTO_PAUSE=true
AUTO_UPDATE=true
AUTO_UPGRADE=true
# Lifetime offered for new instances: deleted (after a backup) this many days after creation.
# Each instance can be set to "keep" instead, when it is created or later. 0 offers "keep" by default.
DELETE_AFTER_DAYS=30
# Once a day at DAILY_BACKUP_TIME (HH:MM in TIMEZONE), back up every instance used since its last daily backup.
# Each instance keeps only its latest daily backup.
DAILY_BACKUPS=true
DAILY_BACKUP_TIME=00:00
TIMEZONE=UTC
# After a restore, the state before it is kept this many hours, and the instance offers "Rollback" meanwhile.
ROLLBACK_HOURS=24
# Back up an instance before an update changes its code, and put it back automatically when the update fails
SAFE_UPDATES=true
# Stages (production, staging, development). Production instances are never paused or deleted automatically, are
# backed up every day and always updated safely. How many may be in production at once (0: no limit):
MAX_PRODUCTION_INSTANCES=1
# New production instances get new code automatically (false: only when someone asks)
PRODUCTION_AUTO_UPDATE=false
# Lifetime offered for new staging instances, in days (0: keep), and whether they get the daily backup too
STAGING_DELETE_AFTER_DAYS=90
STAGING_DAILY_BACKUPS=true
# Projects (one GitHub repository each; its branches run as instances). Production branches per project (0: no
# limit; MAX_PRODUCTION_INSTANCES still limits the server):
PROJECT_PRODUCTION_BRANCHES=1
# Defaults of each project (a project can change them): a new branch pushed to GitHub gets a development instance,
# at most this many at once per project (0: no limit), with Odoo's demo data
PROJECT_AUTO_DEVELOPMENT=true
PROJECT_MAX_AUTO_DEVELOPMENT=3
PROJECT_DEVELOPMENT_DEMO_DATA=true
# A push to a staging branch: rebuild (a new neutralised copy of production, then the code) or keep_data (code only)
PROJECT_STAGING_ON_PUSH=rebuild
# A branch deleted on GitHub: keep, archive (back up and switch off its development instance) or delete (after a
# backup). Staging is archived at most; production is only marked.
PROJECT_BRANCH_DELETED=archive
# A push to a project's upgrade branch (named after the next Odoo version, such as 18.0) runs its upgrade test again
PROJECT_UPGRADE_TEST_ON_PUSH=true
# Database upgrades to a newer Odoo version. Methods allowed: enterprise (Odoo's upgrade service, with the
# customer's Enterprise subscription code) and/or openupgrade (OCA OpenUpgrade, Community); empty: none.
UPGRADE_METHODS=enterprise,openupgrade
# Odoo's upgrade service; its upgrade script is downloaded from <address>/upgrade when an upgrade runs (only here,
# never in the panel: the subscription code is sent there)
# UPGRADE_SERVICE_URL=https://upgrade.odoo.com
# OpenUpgrade: repository, the commit used for each target version (version=commit, comma-separated), openupgradelib
# OPENUPGRADE_REPOSITORY=https://github.com/OCA/OpenUpgrade
# OPENUPGRADE_REFS=16.0=<commit>,17.0=<commit>,18.0=<commit>
# OPENUPGRADE_LIB=openupgradelib==3.13.7
# After a production upgrade, minutes during which it can be cancelled (and is rolled back by itself if Odoo stops
# answering); 0: neither. Longest time one database upgrade may take, in hours.
UPGRADE_ROLLBACK_MINUTES=60
UPGRADE_MAX_HOURS=8
# Off-site copies of backups, to S3-compatible storage (Cloudflare R2, AWS S3, Backblaze B2, MinIO). Each copy has a
# manifest of SHA-256 checksums signed with the panel's Ed25519 key. Usually set on the Settings page, Backups tab.
OFFSITE_BACKUPS=false
OFFSITE_ENDPOINT=
OFFSITE_REGION=auto
OFFSITE_BUCKET=
OFFSITE_PREFIX=sudoo
OFFSITE_ADDRESSING=path
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=
# Production instances' backups are always copied; true also copies staging and development ones
OFFSITE_OTHER_STAGES=false
OFFSITE_KINDS=manual,daily,deletion
# Retention: the newest copy of each of this many most recent days and months
OFFSITE_KEEP_DAILY_PRODUCTION=30
OFFSITE_KEEP_MONTHLY_PRODUCTION=12
OFFSITE_KEEP_DAILY_OTHER=7
OFFSITE_KEEP_MONTHLY_OTHER=0
# Download and check each instance's newest copy when none was checked for this many days (0: only on request)
OFFSITE_VERIFY_DAYS=7
# OFFSITE_TIMEOUT_SECONDS=60
# polling: check GitHub for new commits every this many minutes
POLL_MINUTES=2
# Panel sessions: end after this many idle minutes, and at the latest after this many hours
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
# Recovery codes made when someone sets up the authenticator app (each works once, in place of the app's code)
RECOVERY_CODES_COUNT=10
# New people are invited by e-mail and choose their own password: how long a link works (hours, it works once),
# when an administrator may still set a password instead (no_mail: only while e-mail is not set up; always; never),
# and how many invitations one administrator may send per hour
INVITATION_HOURS=72
INVITATION_PASSWORD_FALLBACK=no_mail
INVITATIONS_PER_HOUR=20
# E-mail people at each sign-in (when e-mail is set up), and whether each may turn it off for their own account
SIGN_IN_EMAIL=true
SIGN_IN_EMAIL_OPT_OUT=true

# ----------------------------------------------------------------------------- alerts (docs/ADMIN_GUIDE.md, Alerts)
# Tell people when something needs attention: failed jobs, rolled-back updates, failed backups, instances down, the
# disk almost full, memory high, changes made outside the panel, missing public links. Also on the Settings page.
ALERTS=true
# Who receives alert e-mails: every super admin with an address, and these addresses (comma-separated)
ALERT_SUPER_ADMINS=true
ALERT_EMAILS=
# Each kind of alert, its threshold and how long a problem must last before it is alerted (minutes)
ALERT_JOB_FAILED=true
ALERT_UPDATE_FAILED=true
ALERT_BACKUP_FAILED=true
ALERT_INSTANCE_DOWN=true
ALERT_INSTANCE_DOWN_MINUTES=5
ALERT_DISK=true
ALERT_DISK_FREE_PERCENT=10
ALERT_MEMORY=true
ALERT_MEMORY_MINUTES=10
ALERT_DRIFT=true
# A backup could not be copied off-site or a copy failed its check; a production instance without a copy for hours
ALERT_OFFSITE_FAILED=true
ALERT_OFFSITE_MISSING=true
ALERT_OFFSITE_MISSING_HOURS=26
ALERT_PUBLIC_LINK=true
ALERT_PUBLIC_LINK_MINUTES=10
# A custom domain's certificate could not be issued or renewed, or expires within ALERT_CERTIFICATE_DAYS
ALERT_CERTIFICATE=true
ALERT_CERTIFICATE_DAYS=14
# A notice when an alerted problem is over; the same alert at most once per ALERT_QUIET_MINUTES (0: every time)
ALERT_RECOVERY=true
ALERT_QUIET_MINUTES=60
# One e-mail a day at ALERT_DIGEST_TIME (HH:MM in TIMEZONE) instead of one per alert
ALERT_DIGEST=false
ALERT_DIGEST_TIME=08:00
# Webhooks (up to 3): https address, secret of the X-Sudoo-Signature HMAC-SHA256, format json, slack, discord or teams
ALERT_WEBHOOK_TIMEOUT_SECONDS=10
# ALERT_WEBHOOK_1_URL=
# ALERT_WEBHOOK_1_SECRET=
# ALERT_WEBHOOK_1_FORMAT=json
# ALERT_WEBHOOK_2_URL=
# ALERT_WEBHOOK_2_SECRET=
# ALERT_WEBHOOK_2_FORMAT=json
# ALERT_WEBHOOK_3_URL=
# ALERT_WEBHOOK_3_SECRET=
# ALERT_WEBHOOK_3_FORMAT=json

# ----------------------------------------------------------------------------- support access (docs/ADMIN_GUIDE.md, Support access)
# Super admins and administrators may let Sudoo.sh support into the panel for a while (needs MARKETPLACE on), at most
# this many hours (1 hour, 1 day and 3 days are offered up to it). Also on the Settings page.
SUPPORT_ACCESS=true
SUPPORT_ACCESS_MAX_HOURS=72

# ----------------------------------------------------------------------------- web shell (docs/ADMIN_GUIDE.md, Web shell)
# A terminal in the browser inside an instance's containers (the Shell tab). Also on the Settings page.
SHELL_ENABLED=true
# Who besides super admins and administrators: admins, maintainers or developers (viewers never)
SHELL_ROLES=admins
# Production instances: off, super_admins or allowed (each one confirmed when opened); root shells for super admins
SHELL_PRODUCTION=super_admins
SHELL_ROOT=false
# Close after minutes without typing, and after minutes in all; how many open per person and per instance
SHELL_IDLE_MINUTES=15
SHELL_MAX_MINUTES=60
SHELL_MAX_PER_USER=2
SHELL_MAX_PER_INSTANCE=3
# SHELL_TICKET_SECONDS=15
# Record shells (encrypted, played by super admins): off, production (and root shells) or all; kept days, sizes in MB
SHELL_RECORDING=production
SHELL_RECORDING_DAYS=30
SHELL_RECORDING_MAX_MB=5
SHELL_RECORDINGS_TOTAL_MB=500

# ----------------------------------------------------------------------------- mail catcher (docs/ADMIN_GUIDE.md, Mail catcher)
# Staging and development instances send their e-mail to the mail catcher (container sudoo-mail), never to real
# addresses; each instance's Mail tab shows its own. Also on the Settings page (E-mail).
MAIL_CATCHER_RETENTION_DAYS=7
MAIL_CATCHER_MAX_MESSAGES=500
MAIL_CATCHER_MAX_MB=200
MAIL_CATCHER_MAX_MESSAGE_MB=25
# Administrators may send a copy of a caught e-mail to an address they type (audit-logged).
MAIL_CATCHER_RELEASE=true

# ----------------------------------------------------------------------------- help panel (the "?" button)
# Contact support: SUPPORT_URL (https:// or mailto:) while the panel is not linked to a Sudoo.sh account; empty: an
# e-mail to ADMIN_CONTACT_EMAIL. Linked: HUB_SUPPORT_URL. Also on the Settings page (General).
# DOCS_URL=https://docs.sudoo.sh
# SUPPORT_URL=
# HUB_SUPPORT_URL=https://app.sudoo.sh/support
# The Sudoo.sh plan (Settings, Plan): where to compare plans, and the account site that manages the plan and, after a
# downgrade, chooses the production branches to keep (PLAN_ACCOUNT_URL/plan).
# PLAN_PRICING_URL=https://sudoo.sh/pricing
# PLAN_ACCOUNT_URL=https://app.sudoo.sh

# ----------------------------------------------------------------------------- marketplace (docs/MARKETPLACE.md)
# on: register with the Sudoo.sh hub, send a signed heartbeat every 15 minutes (version, core hash, fingerprint,
# installed plugins, coarse server figures), and install plugins from the Plugins page. off: the panel never contacts
# the hub; installed free plugins keep working, paid ones stop about 7 days after the last lease. Also on the
# Settings page.
MARKETPLACE=off
# The hub's address. Changing it registers the panel again with that hub.
HUB_URL=https://hub.sudoo.sh
# The hub's root public keys (base64url, comma-separated). Empty: the keys this release ships for hub.sudoo.sh.
# HUB_PUBLIC_KEYS=
# The server's public addresses, for managed subdomains. Empty: the address the server sends from, when public.
# PUBLIC_IPV4=
# PUBLIC_IPV6=

# ----------------------------------------------------------------------------- premium features (docs/PREMIUM.md)
# Premium features install automatically from Sudoo.sh when the plan includes them (also on the Settings page).
PREMIUM_AUTO_INSTALL=true
# PREMIUM_CHECK_HOURS=6
# PREMIUM_RETRY_MINUTES=15
# PREMIUM_WATCH_MINUTES=10
# PREMIUM_BINDING_RENEW_DAYS=7
# PREMIUM_MAX_PACKAGE_MB=60
# The premium signing keys to trust (base64url, comma-separated). Empty: the keys this release ships. Test panels only.
# PREMIUM_PUBLIC_KEYS=

# ----------------------------------------------------------------------------- advanced (defaults rarely change)
# Measure the server and the instances every this many seconds (2 to 60; also on the Settings page)
# METRICS_INTERVAL_SECONDS=5
# cloudflare-quick: the connector image, container name prefix and status ports
# CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
# CONNECTOR_PREFIX=sudoo-connector-
# CONNECTOR_STATUS_PORT_START=20300
# PANEL_CONNECTOR_STATUS_PORT=20242
# Folders inside the panel container: data, documentation, memory-backed folder for short-lived secrets
# ODOO_ROOT=/opt/odoo
# DOCS_DIR=/app/documentation
# MEMORY_DIR=/dev/shm
