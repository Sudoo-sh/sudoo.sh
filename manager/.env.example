# Odoo Instance Manager settings. After a change: cd /opt/odoo/manager && docker compose up -d
# Accounts and passwords are not stored here (see README, "Accounts and roles").

# Who users are told to contact when something needs the administrator
ADMIN_CONTACT_NAME=Yousef M. Y. Al Sabbah
ADMIN_CONTACT_PHONE=
ADMIN_CONTACT_EMAIL=

# Odoo versions offered when creating an instance (tags of the official odoo Docker image)
ODOO_VERSIONS=18.0,19.0,20.0

# Password of the user "admin" in new Odoo instances
ODOO_ADMIN_PASSWORD=admin

# Pause an instance after this many hours without visits
IDLE_HOURS=6

# Lifetime offered for new instances: deleted (after a backup) this many days after creation.
# Each instance can be set to "keep" instead, when it is created or later. 0 offers "keep" by default.
DELETE_AFTER_DAYS=30

# Check GitHub for new commits every this many minutes
POLL_MINUTES=2

# Panel sessions: end after this many idle minutes, and at the latest after this many hours
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
