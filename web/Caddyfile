# The web service of Sudoo.sh: serves the web app, and forwards everything else to the backend.
# Values come from the environment (compose.yaml); WEB_BIND is set by entrypoint.sh from EXPOSURE.
{
	admin off
	auto_https off
	persist_config off
	servers {
		# a visitor must send a request's headers within 10 s and its body within 30 s (the panel's requests are
		# small), and an idle connection is closed after 2 minutes, so slow or abandoned connections cannot pile up
		# and tie up the backend's threads; answers are not limited (the live events stream for hours)
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

http://:{$PANEL_PORT} {
	bind {$WEB_BIND}
	encode zstd gzip

	header -Server

	# live events: long-lived, every event passed on at once
	handle /api/v1/events {
		reverse_proxy 127.0.0.1:{$EVENTS_PORT} {
			flush_interval -1
		}
	}

	# the backend: API, webhooks, documentation pages and their files, health check. Its requests are small JSON
	# documents (the backend refuses more than 64 KB); a much larger body is refused here already
	@backend path /api/* /hooks/* /docs /docs/* /static/* /healthz
	handle @backend {
		request_body {
			max_size 1MB
		}
		reverse_proxy 127.0.0.1:{$API_PORT}
	}

	# the web app
	handle {
		root * /srv
		# form-action allows github.com: Connect GitHub posts the GitHub App manifest there (App Manifest flow)
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self' https://github.com; frame-ancestors 'none'"
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy no-referrer
			Cross-Origin-Opener-Policy same-origin
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		}
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		# the .br and .gz copies made when the app was built (scripts/precompress.mjs): no compressing per answer
		file_server {
			precompressed br gzip
		}
	}
}
