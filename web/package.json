{
  "name": "sudoo-web",
  "private": true,
  "version": "3.1.1",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "description": "Sudoo.sh web app: the panel's front end, a separate service on top of /api/v1.",
  "license": "SEE LICENSE IN ../LICENSE.md",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/precompress.mjs",
    "dev:demo": "vite --mode demo",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview:demo": "vite preview --mode demo",
    "check": "tsc -b --noEmit && node scripts/check-i18n.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chart.js": "^4.6.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.73.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "sass": "^1.108.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
